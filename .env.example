# Database (Vercel Postgres / Neon)
DATABASE_URL=

# Auth — single shared password for user + Celeste
SHARED_PASSWORD=
AUTH_COOKIE_SECRET=

# Cron auth (Vercel sets CRON_SECRET automatically when you add a cron; mirror it here for manual hits)
CRON_SECRET=

# Timezone for digest scheduling
TZ=America/New_York

# Attio — fill in field IDs from Attio admin once
ATTIO_API_KEY=
ATTIO_SCHEDULE_OBJECT=schedule
ATTIO_FALL2026_LIST_ID=
ATTIO_FIELD_NAME=
ATTIO_FIELD_SPOTS=
ATTIO_FIELD_DEADLINE=

# Slack
SLACK_BOT_TOKEN=xoxb-
SLACK_CHANNEL_ID=

# Anthropic — Opus 4.7 PM agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7

# Email Bison — REST API; fill once endpoint shape confirmed
BISON_BASE_URL=
BISON_API_KEY=
